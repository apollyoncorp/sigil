{
  "name": "@apollyoncorp/sigil-mcp",
  "version": "0.4.0",
  "description": "MCP server that lets your own AI assistant draw diagrams for Sigil (.sigil files). It only draws: it never calls an LLM and never touches the network.",
  "license": "MIT",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "excalidraw",
    "sigil",
    "diagram"
  ],
  "homepage": "https://sigil.apollyoncorp.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/apollyoncorp/sigil.git",
    "directory": "sigil-mcp"
  },
  "bugs": {
    "url": "https://github.com/apollyoncorp/sigil/issues"
  },
  "bin": {
    "sigil-mcp": "dist/sigil-mcp.mjs"
  },
  "files": [
    "dist/sigil-mcp.mjs",
    "skill",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:metrics": "node scripts/build-metrics.mjs",
    "build": "node scripts/build-metrics.mjs && node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "test": "node ../node_modules/vitest/vitest.mjs run --config vitest.config.mts",
    "e2e": "node scripts/e2e.mjs",
    "e2e:http": "node scripts/e2e-http.mjs",
    "start:http": "node dist/sigil-mcp.mjs --http"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "fontkit": "2.0.4",
    "linkedom": "0.18.12",
    "zod": "3.25.76"
  },
  "publishConfig": {
    "access": "public"
  }
}
